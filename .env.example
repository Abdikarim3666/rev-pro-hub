# Copy these values into your hosting provider's environment settings.
# Generate a unique secret, for example: python -c "import secrets; print(secrets.token_hex(32))"
REV_SECRET_KEY=replace-with-a-long-random-secret
REV_HTTPS_ONLY=1
REV_ADMIN_NAME=REV Pro-Hub Administrator
REV_ADMIN_EMAIL=admin@example.com
REV_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# Optional absolute path to a persistent SQLite database file:
# REV_DB_PATH=/path/to/persistent-storage/rev_pro_hub.db
